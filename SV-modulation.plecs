          }
        }
        Component {
          Type          CScript
          Name          "SV-Mod"
          Show          on
          Position      [355, 270]
          Direction     up
          Flipped       off
          LabelPosition south
          Parameter {
            Variable      "DialogGeometry"
            Value         "[0 22 1280 649]"
            Show          off
          }
          Parameter {
            Variable      "NumInputs"
            Value         "6"
            Show          off
          }
          Parameter {
            Variable      "NumOutputs"
            Value         "19"
            Show          off
          }
          Parameter {
            Variable      "NumContStates"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "NumDiscStates"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "NumZCSignals"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "DirectFeedthrough"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Ts"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "TerminalBasedSampleTimes"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "Parameters"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "LangStandard"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#include <math.h>\n"
"#include <stdbool.h>\n"
"#define PI 3.14159265358979323846\n"
"#define Va InputSignal(0,0)\n"
"#define Vb InputSignal(0,1)\n"
"#define Vc InputSignal(0,2)\n"
"#define Ts InputSignal(0,3)\n"
"#define Vdc InputSignal(0,4)\n"
"#define carrier InputSignal(0,5)\n"
"double V_alpha, V_beta;\n"
"double Vr, angle, angle_Deg;\n"
"int k=0;\n"
"double theta;\n"
"double M;\n"
"double T1,T2,T0;\n"
"double Ta,Tb,Tc,Td;\n"
"double sine1, sine2, sine3;\n"
"bool s1,s2,s3,s4,s5,s6;"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "//abc-----> alpha-beta transformation\n"
"\n"
"V_alpha =(2.0/3.0)*(Va-0.5*Vb-0.5*Vc);\n"
"V_beta =(2.0/3.0)*((sqrt(3.0)/2.0)*Vb-(sqrt(3.0)/2.0)*Vc);\n"
"\n"
"// magnitude and angle of reference signal\n"
"\n"
"Vr= sqrt(pow(V_alpha,2)+ pow(V_beta,2));\n"
"angle= atan2(V_beta,V_alpha);\n"
"angle_Deg= angle*180.0/PI;\n"
"\n"
"// sector calculation \n"
"\n"
"if (angle_Deg>0 && angle_Deg<=60){\n"
"  k=1;\n"
"}\n"
"else if(angle_Deg>60 && angle_Deg<=120){\n"
"  k=2;\n"
"}\n"
"else if(angle_Deg>120 && angle_Deg<=180){\n"
"  k=3;\n"
"}\n"
"else if(angle_Deg>-180 && angle_Deg<=-120){\n"
"  k=4;\n"
"}\n"
"else if(angle_Deg>-120 && angle_Deg<=-60){\n"
"  k=5;\n"
"}\n"
"else if(angle_Deg>-60 && angle_Deg<=0){\n"
"  k=6;\n"
"}\n"
"\n"
"// theta calcuation\n"
"if (angle_Deg>=0){\n"
"  theta= (angle_Deg-(60*(k-1)))*PI/180.0;\n"
"}else{\n"
"  theta= ((angle_Deg+360)-(60*(k-1)))*PI/180.0;\n"
"}\n"
"\n"
"//modulation index calculation \n"
"M= (Vr*sqrt(3))/Vdc;\n"
"\n"
"// dwell times calculations\n"
"T1= M*Ts*sin((PI/3)-theta);\n"
"T2= M*Ts*sin(theta);\n"
"T0= Ts-T1-T2;\n"
"\n"
"//calculate Ta Tb Tc Td\n"
"Ta=T1+T2+0.5*T0;\n"
"Tb=T1+0.5*T0;\n"
"Tc=T2+0.5*T0;\n"
"Td=0.5*T0;\n"
"\n"
"//switching generator\n"
"\n"
"switch (k){\n"
" case 1:\n"
"  sine1=Ta;\n"
"  sine2=Tc;\n"
"  sine3=Td;\n"
"  break;\n"
" case 2:\n"
"  sine1=Tb;\n"
"  sine2=Ta;\n"
"  sine3=Td;\n"
"  break;\n"
" case 3:\n"
"  sine1=Td;\n"
"  sine2=Ta;\n"
"  sine3=Tc;\n"
"  break;\n"
" case 4:\n"
"  sine1=Td;\n"
"  sine2=Tb;\n"
"  sine3=Ta;\n"
"  break;\n"
" case 5:\n"
"  sine1=Tc;\n"
"  sine2=Td;\n"
"  sine3=Ta;\n"
"  break;\n"
" case 6:\n"
"  sine1=Ta;\n"
"  sine2=Td;\n"
"  sine3=Tb;\n"
"  break;\n"
"}\n"
"\n"
"// comparing with carrier signal\n"
"//S1 and S2\n"
"if(sine1>=carrier){\n"
" s1=1;\n"
" s2=!s1;\n"
"}else if (sine1<carrier){\n"
" s1=0;\n"
" s2=!s1;\n"
"}\n"
"//S3 and S4\n"
"if(sine2>=carrier){\n"
" s3=1;\n"
" s4=!s3;\n"
"}else if (sine1<carrier){\n"
" s3=0;\n"
" s4=!s3;\n"
"}\n"
"//S3 and S4\n"
"if(sine3>=carrier){\n"
" s5=1;\n"
" s6=!s5;\n"
"}else if (sine1<carrier){\n"
" s5=0;\n"
" s6=!s5;\n"
"}\n"
"\n"
"//outputs\n"
"\n"
"OutputSignal(0,0)= V_alpha;\n"
"OutputSignal(0,1)= V_beta;\n"
"OutputSignal(0,2)= Vr;\n"
"OutputSignal(0,3)= angle*180.0/PI;\n"
"OutputSignal(0,4)= k;\n"
"OutputSignal(0,5)= theta;\n"
"OutputSignal(0,6)=M;\n"
"OutputSignal(0,7)=T1;\n"
"OutputSignal(0,8)=T2;\n"
"OutputSignal(0,9)=T0;\n"
"OutputSignal(0,10)=sine1;\n"
"OutputSignal(0,11)=sine2;\n"
"OutputSignal(0,12)=sine3;\n"
"OutputSignal(0,13)=s1;\n"
"OutputSignal(0,14)=s2;\n"
"OutputSignal(0,15)=s3;\n"
"OutputSignal(0,16)=s4;\n"
"OutputSignal(0,17)=s5;\n"
"OutputSignal(0,18)=s6;\n"
            Show          off
          }
