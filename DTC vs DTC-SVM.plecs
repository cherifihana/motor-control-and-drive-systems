          }
          Parameter {
            Variable      "Declarations"
            Value         "#include <math.h>\n"
"#define PI 3.14159265358979323846\n"
"#define theta InputSignal(0,0)\n"
"int k=0;\n"
"double theta_deg;"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "theta_deg= theta*180/PI;\n"
"\n"
"if (theta_deg>-30 && theta_deg<=30){\n"
"  k=1;\n"
"}\n"
"else if(theta_deg>30 && theta_deg<=90){\n"
"  k=2;\n"
"}\n"
"else if(theta_deg>90 && theta_deg<=150){\n"
"  k=3;\n"
"}\n"
"else if((theta_deg>150&& theta_deg<=180) || (theta_deg>-180 && theta_deg<=-15"
"0)){\n"
"  k=4;\n"
"}\n"
"else if(theta_deg>-150 && theta_deg<=-90){\n"
"  k=5;\n"
"}\n"
"else if(theta_deg>-90 && theta_deg<=-30){\n"
"  k=6;\n"
"}\n"
"OutputSignal(0,0)= k;"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
