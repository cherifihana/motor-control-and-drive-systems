      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "\n"
"#define PI 3.14159265358979323846\n"
"#define EF InputSignal(0,0)\n"
"#define ET InputSignal(0,1)\n"
"#define k (int) InputSignal(0,2)\n"
"int V[8][3] = {\n"
"    {0, 0, 0},  // V0 - Zero vector\n"
"    {1, 0, 0},  // V1\n"
"    {1, 1, 0},  // V2\n"
"    {0, 1, 0},  // V3\n"
"    {0, 1, 1},  // V4\n"
"    {0, 0, 1},  // V5\n"
"    {1, 0, 1},  // V6\n"
"    {1, 1, 1}   // V7 - Zero vector\n"
"};\n"
"int s1,s2,s3,s4,s5,s6;\n"
"int *V_selec;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "// for positive flux error\n"
"if(EF==1){\n"
" if (ET==1){\n"
"  switch(k){\n"
"   case 1:\n"
"     V_selec=V[2];\n"
"     break;\n"
"   case 2:\n"
"     V_selec=V[3];\n"
"     break;\n"
"   case 3:\n"
"     V_selec=V[4];\n"
"     break;\n"
"   case 4:\n"
"     V_selec=V[5];\n"
"     break; \n"
"   case 5:\n"
"     V_selec=V[6];\n"
"     break;    \n"
"   case 6:\n"
"     V_selec=V[1];\n"
"     break;    \n"
"   }}\n"
" else if (ET==0){\n"
"  switch(k){\n"
"   case 1:\n"
"    V_selec=V[7];\n"
"    break;\n"
"   case 2:\n"
"     V_selec=V[0];\n"
"     break;\n"
"   case 3:\n"
"     V_selec=V[7];\n"
"     break;\n"
"   case 4:\n"
"     V_selec=V[0];\n"
"     break; \n"
"   case 5:\n"
"     V_selec=V[7];\n"
"     break;    \n"
"   case 6:\n"
"     V_selec=V[0];\n"
"     break;    \n"
"   }\n"
" }  \n"
" else if (ET==-1){\n"
"  switch(k){\n"
"   case 1:\n"
"    V_selec=V[6];\n"
"    break;\n"
"   case 2:\n"
"     V_selec=V[1];\n"
"     break;\n"
"   case 3:\n"
"     V_selec=V[2];\n"
"     break;\n"
"   case 4:\n"
"     V_selec=V[3];\n"
"     break; \n"
"   case 5:\n"
"     V_selec=V[4];\n"
"     break;    \n"
"   case 6:\n"
"     V_selec=V[5];\n"
"     break;    \n"
"   }\n"
" }   \n"
"}\n"
"\n"
"\n"
"// for negative flux error\n"
"else if (EF==-1){\n"
"if (ET==1){\n"
"  switch(k){\n"
"   case 1:\n"
"     V_selec=V[3];\n"
"     break;\n"
"   case 2:\n"
"     V_selec=V[4];\n"
"     break;\n"
"   case 3:\n"
"     V_selec=V[5];\n"
"     break;\n"
"   case 4:\n"
"     V_selec=V[6];\n"
"     break; \n"
"   case 5:\n"
"     V_selec=V[1];\n"
"     break;    \n"
"   case 6:\n"
"     V_selec=V[2];\n"
"     break;    \n"
"   }}\n"
" else if (ET==0){\n"
"  switch(k){\n"
"   case 1:\n"
"    V_selec=V[0];\n"
"    break;\n"
"   case 2:\n"
"     V_selec=V[7];\n"
"     break;\n"
"   case 3:\n"
"     V_selec=V[0];\n"
"     break;\n"
"   case 4:\n"
"     V_selec=V[7];\n"
"     break; \n"
"   case 5:\n"
"     V_selec=V[0];\n"
"     break;    \n"
"   case 6:\n"
"     V_selec=V[7];\n"
"     break;    \n"
"   }\n"
" }  \n"
" else if (ET==-1){\n"
"  switch(k){\n"
"   case 1:\n"
"    V_selec=V[5];\n"
"    break;\n"
"   case 2:\n"
"     V_selec=V[6];\n"
"     break;\n"
"   case 3:\n"
"     V_selec=V[1];\n"
"     break;\n"
"   case 4:\n"
"     V_selec=V[2];\n"
"     break; \n"
"   case 5:\n"
"     V_selec=V[3];\n"
"     break;    \n"
"   case 6:\n"
"     V_selec=V[4];\n"
"     break;    \n"
"   }\n"
" }   \n"
"}\n"
"s1= V_selec[0];\n"
"s3= V_selec[1];\n"
"s5= V_selec[2];\n"
"s2 =!s1;\n"
"s4 =!s3;\n"
"s6 =!s5;\n"
"\n"
"OutputSignal(0,0)= s1;\n"
"OutputSignal(0,1)= s2;\n"
"OutputSignal(0,2)= s3;\n"
"OutputSignal(0,3)= s4;\n"
"OutputSignal(0,4)= s5;\n"
"OutputSignal(0,5)= s6;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
